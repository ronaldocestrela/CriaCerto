@page "/maternity/farrowings"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using CriaCerto.Web.Client.Components.Maternity
@using CriaCerto.Web.Client.Components.Plantel
@using CriaCerto.Web.Client.Models
@inject CriaCerto.Web.Client.Services.MaternityApiClient MaternityApi
@inject NavigationManager Navigation

<PageTitle>Cria Certo - Registo de Partos e Maternidade</PageTitle>

<ModuleGuard Module="Maternity">
    <div class="maternity-page-container">
        <header class="maternity-header">
            <div class="header-branding">
                <span class="material-symbols-outlined header-icon">maternity</span>
                <div>
                    <h1>Maternidade & Partos</h1>
                    <p class="subtitle">Gestão zootécnica de nascimentos, adoções, desmame e indicadores NVMA/DMA</p>
                </div>
            </div>
            <div class="header-actions">
                <div class="sync-status-badge @(_isOnline ? "online" : "offline")">
                    <span class="material-symbols-outlined">@(_isOnline ? "wifi" : "wifi_off")</span>
                    <span>@(_isOnline ? "Online" : "Offline (Rural)")</span>
                    @if (_pendingOfflineCount > 0)
                    {
                        <span class="pending-chip">@_pendingOfflineCount pendente(s)</span>
                    }
                </div>
                <button type="button" class="btn-secondary" @onclick="OpenTransferModal">
                    <span class="material-symbols-outlined">swap_horiz</span>
                    <span>Adoção / Transferência</span>
                </button>
                <button type="button" class="btn-new-farrowing" @onclick="OpenFarrowingModal">
                    <span class="material-symbols-outlined">add_circle</span>
                    <span>Novo Parto</span>
                </button>
            </div>
        </header>

        @if (_metrics is not null)
        {
            <section class="maternity-kpi-grid">
                <div class="kpi-card nvma">
                    <div class="kpi-icon"><span class="material-symbols-outlined">numbers</span></div>
                    <div class="kpi-info">
                        <span class="kpi-label">NVMA</span>
                        <strong class="kpi-value">@_metrics.Nvma.ToString("F2")</strong>
                        <span class="kpi-subtext">Nascidos Vivos / Matriz / Ano</span>
                    </div>
                </div>

                <div class="kpi-card dma">
                    <div class="kpi-icon"><span class="material-symbols-outlined">output</span></div>
                    <div class="kpi-info">
                        <span class="kpi-label">DMA</span>
                        <strong class="kpi-value">@_metrics.Dma.ToString("F2")</strong>
                        <span class="kpi-subtext">Desmamados / Matriz / Ano</span>
                    </div>
                </div>

                <div class="kpi-card mortality">
                    <div class="kpi-icon"><span class="material-symbols-outlined">show_chart</span></div>
                    <div class="kpi-info">
                        <span class="kpi-label">Mortalidade Pré-Desmame</span>
                        <strong class="kpi-value">@_metrics.PreWeaningMortalityRate.ToString("F1")%</strong>
                        <span class="kpi-subtext">Leitões mortos antes do desmame</span>
                    </div>
                </div>

                <div class="kpi-card sows">
                    <div class="kpi-icon"><span class="material-symbols-outlined">pets</span></div>
                    <div class="kpi-info">
                        <span class="kpi-label">Matrizes Ativas</span>
                        <strong class="kpi-value">@_metrics.TotalActiveSows</strong>
                        <span class="kpi-subtext">@_metrics.TotalWeanedInPeriod desmamados no período</span>
                    </div>
                </div>
            </section>
        }

        <section class="maternity-filter-bar">
            <div class="filter-group">
                <span class="material-symbols-outlined search-icon">filter_alt</span>
                <input type="text" class="filter-input" @bind="_maternityRoomFilter" @bind:after="ApplyFilter" placeholder="Filtrar por Sala (ex: Sala-01)..." />
            </div>

            @if (_pendingOfflineCount > 0 && _isOnline)
            {
                <button type="button" class="btn-sync-now" @onclick="SyncPendingAsync">
                    <span class="material-symbols-outlined">sync</span>
                    <span>Sincronizar @_pendingOfflineCount partos pendente(s)</span>
                </button>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
        {
            <div class="feedback-banner">
                <span class="material-symbols-outlined">info</span>
                <span>@_feedbackMessage</span>
            </div>
        }

        <main class="maternity-content">
            @if (_isLoading)
            {
                <div class="loading-state">
                    <span class="material-symbols-outlined spinner">progress_activity</span>
                    <p>Carregando partos da maternidade...</p>
                </div>
            }
            else if (_farrowings.Count == 0)
            {
                <div class="empty-state">
                    <span class="material-symbols-outlined empty-icon">child_care</span>
                    <h3>Nenhum parto registrado</h3>
                    <p>Utilize o botão "Novo Parto" para registrar os nascimentos na maternidade.</p>
                </div>
            }
            else
            {
                <div class="farrowings-grid">
                    @foreach (var item in _farrowings)
                    {
                        <article class="farrowing-card">
                            <header class="card-header">
                                <div class="sow-info">
                                    <span class="material-symbols-outlined">pets</span>
                                    <strong>Matriz ID: @item.SowId.ToString().Substring(0, 8)...</strong>
                                </div>
                                <span class="room-badge">@(item.MaternityRoomId ?? "Sem sala")</span>
                            </header>

                            <div class="card-date">
                                <span class="material-symbols-outlined">calendar_today</span>
                                <span>@item.FarrowingDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="card-metrics">
                                <div class="metric live">
                                    <span class="metric-label">Vivos</span>
                                    <strong class="metric-value">@item.LiveBorn</strong>
                                </div>
                                <div class="metric stillborn">
                                    <span class="metric-label">Natimortos</span>
                                    <strong class="metric-value">@item.Stillborn</strong>
                                </div>
                                <div class="metric mummified">
                                    <span class="metric-label">Mumificados</span>
                                    <strong class="metric-value">@item.Mummified</strong>
                                </div>
                                <div class="metric total">
                                    <span class="metric-label">Total</span>
                                    <strong class="metric-value">@item.TotalBorn</strong>
                                </div>
                            </div>

                            <footer class="card-footer-actions">
                                <span class="litter-weight">Peso: <strong>@item.LitterWeightKg.ToString("F1") kg</strong></span>
                                <div class="action-buttons">
                                    <button type="button" class="btn-card-action" title="Registrar Desmame" @onclick="() => OpenWeaningModal(item)">
                                        <span class="material-symbols-outlined">output</span>
                                        <span>Desmamar</span>
                                    </button>
                                </div>
                            </footer>
                        </article>
                    }
                </div>
            }
        </main>

        <FarrowingEntryModal @bind-IsOpen="_isFarrowingModalOpen" OnSubmit="HandleFarrowingSubmit" />
        <PigletTransferModal @bind-IsOpen="_isTransferModalOpen" AvailableFarrowings="_farrowings" OnSubmit="HandleTransferSubmit" />
        <WeaningModal @bind-IsOpen="_isWeaningModalOpen" SelectedFarrowing="_selectedFarrowingForWeaning" OnSubmit="HandleWeaningSubmit" />
    </div>
</ModuleGuard>

@code {
    private List<FarrowingSummaryClientDto> _farrowings = new();
    private MaternityMetricsClientDto? _metrics;
    private bool _isLoading = true;
    private bool _isOnline = true;
    private int _pendingOfflineCount = 0;
    private string _maternityRoomFilter = string.Empty;

    private bool _isFarrowingModalOpen = false;
    private bool _isTransferModalOpen = false;
    private bool _isWeaningModalOpen = false;
    private FarrowingSummaryClientDto? _selectedFarrowingForWeaning;

    private string? _feedbackMessage;

    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        _isOnline = await MaternityApi.IsOnlineAsync();
        _pendingOfflineCount = await MaternityApi.GetPendingOfflineCountAsync();
        _farrowings = await MaternityApi.GetFarrowingsAsync(maternityRoomId: string.IsNullOrWhiteSpace(_maternityRoomFilter) ? null : _maternityRoomFilter);
        _metrics = await MaternityApi.GetMetricsAsync();
        _isLoading = false;
    }

    private async Task ApplyFilter()
    {
        await RefreshDataAsync();
    }

    private void OpenFarrowingModal()
    {
        _isFarrowingModalOpen = true;
    }

    private void OpenTransferModal()
    {
        _isTransferModalOpen = true;
    }

    private void OpenWeaningModal(FarrowingSummaryClientDto farrowing)
    {
        _selectedFarrowingForWeaning = farrowing;
        _isWeaningModalOpen = true;
    }

    private async Task HandleFarrowingSubmit(RegisterFarrowingRequest request)
    {
        var result = await MaternityApi.RegisterFarrowingAsync(request);
        if (result is not null)
        {
            _feedbackMessage = "Parto registrado com sucesso!";
        }
        else
        {
            _feedbackMessage = "Parto salvo offline no dispositivo. Será sincronizado quando a conexão retornar.";
        }

        await RefreshDataAsync();
    }

    private async Task HandleTransferSubmit(TransferPigletRequest request)
    {
        var result = await MaternityApi.TransferPigletAsync(request);
        if (result is not null)
        {
            _feedbackMessage = "Adoção/Transferência registrada com sucesso!";
        }
        else
        {
            _feedbackMessage = "Falha ao registrar adoção. Verifique o saldo da matriz doadora.";
        }

        await RefreshDataAsync();
    }

    private async Task HandleWeaningSubmit(RegisterWeaningRequest request)
    {
        var result = await MaternityApi.RegisterWeaningAsync(request);
        if (result is not null)
        {
            _feedbackMessage = "Desmame registrado com sucesso! Leitões prontos para transferência para a Creche.";
        }
        else
        {
            _feedbackMessage = "Falha ao registrar desmame. Verifique se o parto já possui desmame registrado.";
        }

        await RefreshDataAsync();
    }

    private async Task SyncPendingAsync()
    {
        var synced = await MaternityApi.FlushOfflineQueueAsync();
        _feedbackMessage = synced > 0 ? $"{synced} parto(s) sincronizado(s) com sucesso!" : "Nenhum parto pendente para sincronizar.";
        await RefreshDataAsync();
    }
}
