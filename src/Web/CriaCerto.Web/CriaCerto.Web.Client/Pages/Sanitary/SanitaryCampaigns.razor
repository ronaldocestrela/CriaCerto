@page "/sanitary/campaigns"
@using CriaCerto.Modules.Sanitary.Application.Domain
@using CriaCerto.Modules.Sanitary.Application.Contracts
@attribute [Authorize]

<PageTitle>Campanhas Sanitárias & Carência | CriaCerto</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-shield-check me-2"></i>Campanhas Sanitárias & Controle de Carência
            </h3>
            <p class="text-muted mb-0">Gestão de vacinações oficiais (Aftosa, Brucelose, Raiva), registro de tratamentos e bloqueio sanitário de abate.</p>
        </div>
        <div>
            <button class="btn btn-outline-danger me-2 shadow-sm" @onclick="OpenTreatmentModal">
                <i class="bi bi-capsule me-1"></i> Aplicar Tratamento / Carência
            </button>
            <button class="btn btn-primary shadow-sm" @onclick="OpenCampaignModal">
                <i class="bi bi-plus-lg me-1"></i> Nova Campanha Oficial
            </button>
        </div>
    </div>

    <!-- CARDS DE METRICAS SANITARIAS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small opacity-75 text-uppercase fw-semibold">Campanhas Ativas</span>
                            <h3 class="fw-bold mb-0">@campaigns.Count</h3>
                        </div>
                        <i class="bi bi-megaphone fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-danger text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small opacity-75 text-uppercase fw-semibold">Animais em Carência para Abate</span>
                            <h3 class="fw-bold mb-0">@treatments.Count(t => t.IsWithdrawalActive)</h3>
                        </div>
                        <i class="bi bi-slash-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small opacity-75 text-uppercase fw-semibold">Status de Imunização</span>
                            <h3 class="fw-bold mb-0">100% Conforme</h3>
                        </div>
                        <i class="bi bi-check-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABELA DE CAMPANHAS ATIVAS -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-dark"><i class="bi bi-calendar-event me-2 text-primary"></i>Campanhas Sanitárias Declaradas</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome da Campanha</th>
                        <th>Tipo</th>
                        <th>Período</th>
                        <th>Status</th>
                        <th>Observações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in campaigns)
                    {
                        <tr>
                            <td><strong class="text-primary">@c.Name</strong></td>
                            <td><span class="badge bg-light text-dark border">@c.Type</span></td>
                            <td>@c.StartDateUtc.ToString("dd/MM/yyyy") até @c.EndDateUtc.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-success"><i class="bi bi-check me-1"></i>Ativa</span></td>
                            <td>@(c.Description ?? "Sem observações")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TABELA DE TRATAMENTOS COM CARENCIA -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-dark"><i class="bi bi-capsule me-2 text-danger"></i>Registro de Tratamentos Veterinários & Carência Sanitária</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Medicamento / Produto</th>
                        <th>Tipo</th>
                        <th>Dosagem / Lote</th>
                        <th>Data Aplicação</th>
                        <th>Carência (Dias)</th>
                        <th>Término Carência</th>
                        <th>Status de Abate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in treatments)
                    {
                        <tr>
                            <td><strong class="text-dark">@t.ProductCommercialName</strong></td>
                            <td><span class="badge bg-info text-dark">@t.Type</span></td>
                            <td>@t.Dosage (@(t.BatchNumber ?? "N/A"))</td>
                            <td>@t.ApplicationDateUtc.ToString("dd/MM/yyyy")</td>
                            <td>@t.WithdrawalDays dias</td>
                            <td>@t.WithdrawalEndDateUtc.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (t.IsWithdrawalActive)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> BLOQUEADO PARA ABATE
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> Liberado para Abate
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<VaccinationCampaignDto> campaigns = new()
    {
        new VaccinationCampaignDto(Guid.NewGuid(), "Campanha Oficial Febre Aftosa 2026", CampaignType.Aftosa, DateTime.UtcNow.AddDays(-10), DateTime.UtcNow.AddDays(20), "Vacinação obrigatória de bovinos até 24 meses.", true, DateTime.UtcNow),
        new VaccinationCampaignDto(Guid.NewGuid(), "Campanha Brucelose Fêmeas 2026", CampaignType.Brucelose, DateTime.UtcNow.AddDays(-5), DateTime.UtcNow.AddDays(25), "Vacinação B19 em bezerras de 3 a 8 meses.", true, DateTime.UtcNow)
    };

    private List<TreatmentRecordDto> treatments = new()
    {
        new TreatmentRecordDto(Guid.NewGuid(), Guid.NewGuid(), null, "Dectomax Injectable 1%", TreatmentType.Deworming, "Lote DEC-99", "10ml SC", 35, DateTime.UtcNow.AddDays(-10), DateTime.UtcNow.AddDays(25), true, "Dr. Roberto Vet", "Vermifugação geral lote engorda"),
        new TreatmentRecordDto(Guid.NewGuid(), Guid.NewGuid(), null, "Oxitetraciclina LA", TreatmentType.Medication, "Lote OXI-04", "15ml IM", 28, DateTime.UtcNow.AddDays(-40), DateTime.UtcNow.AddDays(-12), false, "Dr. Roberto Vet", "Tratamento preventivo podal")
    };

    private void OpenCampaignModal() { }
    private void OpenTreatmentModal() { }
}
