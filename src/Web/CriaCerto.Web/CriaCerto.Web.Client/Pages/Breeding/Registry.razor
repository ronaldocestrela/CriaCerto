@page "/breeding/registry"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using CriaCerto.Web.Client.Components.Plantel
@using CriaCerto.Web.Client.Models
@inject CriaCerto.Web.Client.Services.PlantelApiClient PlantelApi
@inject IJSRuntime JSRuntime

<PageTitle>Cria Certo - Plantel de Matrizes Bovinas</PageTitle>

<ModuleGuard Module="Breeding">
    <div class="plantel-page">
        <OfflineBanner Visible="@_offlineMode" />

        <section class="plantel-hero">
            <div>
                <p class="plantel-breadcrumb">PLANTEL / BOVINOCULTURA</p>
                <h1>Registro de Matrizes e Reprodutores Bovinos</h1>
                <p>Gestão zootécnica e reprodutiva do rebanho bovino para curral e pasto.</p>
            </div>
            <button type="button" class="plantel-primary-action">
                <span class="material-symbols-outlined">add</span>
                Cadastrar Matriz
            </button>
        </section>

        <section class="plantel-kpi-grid">
            <KpiStatCard Label="Total de Matrizes" Value="@_cows.Count.ToString("N0")" Trend="Vacas em acompanhamento" Icon="groups" />
            <KpiStatCard Label="IEP Médio" Value="@AverageIep.ToString("0.0")" Trend="Meses de Intervalo Entre Partos" Icon="timer" IconClass="primary" />
            <KpiStatCard Label="Confirmadas Prenhes" Value="@PregnantCount.ToString("N0")" Trend="Diagnósticos positivos de gestação" Icon="child_care" />
        </section>

        <section class="plantel-toolbar">
            <PlantelSearchBar Search="@_search" SearchChanged="OnSearchChanged" Placeholder="Buscar por Brinco, SISBOV ou RFID..." />
            <div class="plantel-filter-row">
                <span>FILTRAR POR:</span>
                <button class="@FilterClass(null)" @onclick="() => SetFilter(null)">Todas</button>
                <button class="@FilterClass(ReproductiveStatus.Open)" @onclick="() => SetFilter(ReproductiveStatus.Open)">Vazia</button>
                <button class="@FilterClass(ReproductiveStatus.InIatfProtocol)" @onclick="() => SetFilter(ReproductiveStatus.InIatfProtocol)">Protocolo IATF</button>
                <button class="@FilterClass(ReproductiveStatus.Inseminated)" @onclick="() => SetFilter(ReproductiveStatus.Inseminated)">Inseminada</button>
                <button class="@FilterClass(ReproductiveStatus.Pregnant)" @onclick="() => SetFilter(ReproductiveStatus.Pregnant)">Prenhe</button>
            </div>
        </section>

        <section class="plantel-table-card">
            <table class="plantel-table" aria-label="Matrizes bovinas cadastradas">
                <thead>
                    <tr>
                        <th>Brinco / Identificação</th>
                        <th>Status Reprodutivo</th>
                        <th>Partos (Nº)</th>
                        <th>IEP (Meses)</th>
                        <th>Último Parto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cow in FilteredCows)
                    {
                        <tr>
                            <td>
                                <strong class="plantel-tag">@cow.EarTag</strong>
                                <small>@cow.Breed | SISBOV: @(cow.SisbovId ?? "N/A")</small>
                            </td>
                            <td><span class="status-badge">@cow.Status</span></td>
                            <td>@cow.ParityCount</td>
                            <td>@(cow.IepMonths?.ToString("0.0") ?? "-")</td>
                            <td>@(cow.LastCalvingDate?.ToString("dd/MM/yyyy") ?? "Sem registros")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </div>
</ModuleGuard>

@code {
    private readonly List<CowSummaryDto> _cows = new();
    private string? _search;
    private ReproductiveStatus? _status;
    private bool _offlineMode;

    private IEnumerable<CowSummaryDto> FilteredCows => _cows.Where(c =>
        (!_status.HasValue || c.Status == _status.Value) &&
        (string.IsNullOrWhiteSpace(_search) || c.EarTag.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private double AverageIep => _cows.Where(c => c.IepMonths.HasValue).Select(c => c.IepMonths!.Value).DefaultIfEmpty(12.5).Average();
    private int PregnantCount => _cows.Count(c => c.Status == ReproductiveStatus.Pregnant);

    protected override async Task OnInitializedAsync()
    {
        await LoadCowsAsync();
    }

    private async Task LoadCowsAsync()
    {
        try
        {
            var response = await PlantelApi.ListCowsAsync(_search, _status);
            _cows.Clear();
            if (response?.Items.Count > 0)
            {
                _cows.AddRange(response.Items);
            }
            else
            {
                SeedFallbackData();
            }
            _offlineMode = false;
        }
        catch
        {
            SeedFallbackData();
            _offlineMode = true;
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        await LoadCowsAsync();
    }

    private async Task SetFilter(ReproductiveStatus? status)
    {
        _status = status;
        await LoadCowsAsync();
    }

    private string FilterClass(ReproductiveStatus? status) => _status == status ? "active" : string.Empty;

    private void SeedFallbackData()
    {
        _cows.Clear();
        _cows.AddRange(new[]
        {
            new CowSummaryDto(Guid.NewGuid(), "BR-101", "1000293", "RFID-001", "Nelore", ReproductiveStatus.Pregnant, 3, new DateTime(2025, 2, 10), 12.2),
            new CowSummaryDto(Guid.NewGuid(), "BR-102", "1000294", "RFID-002", "Angus x Nelore", ReproductiveStatus.InIatfProtocol, 1, new DateTime(2024, 11, 05), 13.0),
            new CowSummaryDto(Guid.NewGuid(), "BR-103", null, null, "Gyr Leiteiro", ReproductiveStatus.Open, 2, new DateTime(2024, 12, 01), 12.8),
            new CowSummaryDto(Guid.NewGuid(), "BR-104", "1000298", "RFID-005", "Nelore PO", ReproductiveStatus.Pregnant, 5, new DateTime(2024, 10, 15), 11.9)
        });
    }
}
