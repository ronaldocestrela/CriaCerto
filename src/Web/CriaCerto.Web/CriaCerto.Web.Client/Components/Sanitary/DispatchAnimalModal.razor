@using CriaCerto.Web.Client.Models
@using CriaCerto.Web.Client.Services
@inject GrowthApiClient ApiClient

<div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-truck me-2"></i>Despacho / Emissão de Lote - Animal @AnimalEarTag
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body p-4">
                @if (isCheckingEligibility)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-success" role="status">
                            <span class="visually-hidden">Consultando carência sanitária...</span>
                        </div>
                        <p class="text-muted small mt-2">Consultando histórico veterinário e carência sanitária...</p>
                    </div>
                }
                else
                {
                    @if (eligibility != null && !eligibility.IsEligibleForSlaughter && isSlaughter)
                    {
                        <div class="alert alert-danger border-start border-danger border-4 shadow-sm mb-4 rounded-3 p-3">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-shield-x fs-2 me-3 text-danger"></i>
                                <div>
                                    <h6 class="fw-bold mb-1 text-danger">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>TRAVA SANITÁRIA DE ABATE ATIVA
                                    </h6>
                                    <p class="small mb-2 text-dark">
                                        Este animal está sob <strong>Período de Carência Medicamentosa</strong> e NÃO pode ser despachado para abate imediato.
                                    </p>
                                    <ul class="list-unstyled small mb-0 text-muted">
                                        <li><strong>Medicamento Aplicado:</strong> @(eligibility.BlockingTreatmentName ?? "Tratamento Veterinário")</li>
                                        <li><strong>Dias Restantes de Carência:</strong> <span class="badge bg-danger">@eligibility.RemainingWithdrawalDays dia(s)</span></li>
                                        <li><strong>Data Prevista para Liberação:</strong> @(eligibility.ActiveWithdrawalEndsAtUtc?.ToString("dd/MM/yyyy") ?? "N/A")</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Finalidade do Despacho</label>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="isSlaughterCheck" @bind="isSlaughter" />
                            <label class="form-check-label fw-semibold text-dark" for="isSlaughterCheck">
                                Despacho para Abate em Frigorífico (Sujeito a Trava Sanitária)
                            </label>
                        </div>
                        <small class="text-muted d-block">
                            Desmarcar esta opção para vendas em vida, recria, terminação ou transferência entre propriedades.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Destino / Comprador / Frigorífico</label>
                        <input type="text" class="form-control" placeholder="Ex: Frigorífico Minerva - Unidade Barretos/SP" @bind="destination" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Data do Despacho</label>
                        <input type="date" class="form-control" @bind="dispatchDate" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-x-circle me-1"></i>@errorMessage
                        </div>
                    }
                }
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                <button class="btn btn-success fw-bold" 
                        disabled="@(isCheckingEligibility || (isSlaughter && eligibility != null && !eligibility.IsEligibleForSlaughter))" 
                        @onclick="SaveDispatch">
                    <i class="bi bi-check-circle me-1"></i> Confirmar Despacho
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public Guid AnimalId { get; set; }
    [Parameter] public string AnimalEarTag { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDispatched { get; set; }

    private bool isCheckingEligibility = true;
    private CriaCerto.Web.Client.Models.SlaughterEligibilityDto? eligibility;
    private bool isSlaughter = true;
    private string destination = "";
    private DateTime dispatchDate = DateTime.Today;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        isCheckingEligibility = true;
        eligibility = await ApiClient.ValidateSlaughterEligibilityAsync(AnimalId);
        isCheckingEligibility = false;
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SaveDispatch()
    {
        if (string.IsNullOrWhiteSpace(destination))
        {
            errorMessage = "Informe o destino ou nome do comprador/frigorífico.";
            return;
        }

        if (isSlaughter && eligibility != null && !eligibility.IsEligibleForSlaughter)
        {
            errorMessage = "Operação bloqueada por carência medicamentosa sanitária.";
            return;
        }

        errorMessage = "";
        var cmd = new DispatchAnimalCommand(
            TenantId,
            AnimalId,
            AnimalEarTag,
            destination,
            dispatchDate,
            isSlaughter);

        var response = await ApiClient.DispatchAnimalAsync(cmd);
        if (response.IsSuccessStatusCode)
        {
            await OnDispatched.InvokeAsync();
            await CloseModal();
        }
        else
        {
            errorMessage = "Falha ao registrar despacho. Verifique as regras de negócio.";
        }
    }
}
