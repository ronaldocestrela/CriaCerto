@using CriaCerto.Web.Client.Models
@using CriaCerto.Web.Client.Services
@inject IToastService ToastService
@implements IDisposable

<div class="toast-container-wrapper" aria-live="polite" aria-atomic="true">
    @foreach (var toast in ToastService.ActiveToasts)
    {
        <div class="toast-card toast-@toast.Level.ToString().ToLowerInvariant()" key="@toast.Id">
            <div class="toast-header">
                <span class="material-symbols-outlined toast-icon">@GetIcon(toast.Level)</span>
                <strong class="toast-title">@toast.Title</strong>
                <button type="button" class="toast-close-btn" @onclick="() => ToastService.RemoveToast(toast.Id)" aria-label="Fechar">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="toast-body">
                @toast.Message
            </div>
        </div>
    }
</div>

<style>
    .toast-container-wrapper {
        position: fixed;
        top: 1.25rem;
        right: 1.25rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-width: 400px;
        width: 100%;
        pointer-events: none;
    }

    .toast-card {
        pointer-events: auto;
        border-radius: 12px;
        padding: 0.875rem 1rem;
        background: rgba(23, 33, 27, 0.95);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        color: #f1f5f9;
        font-family: inherit;
        animation: toast-slide-in 0.3s ease-out forwards;
    }

    .toast-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.375rem;
    }

    .toast-icon {
        font-size: 1.25rem;
    }

    .toast-title {
        font-size: 0.9375rem;
        font-weight: 600;
        flex: 1;
    }

    .toast-close-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 0.125rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: color 0.15s, background 0.15s;
    }

    .toast-close-btn:hover {
        color: #f8fafc;
        background: rgba(255, 255, 255, 0.1);
    }

    .toast-body {
        font-size: 0.875rem;
        color: #cbd5e1;
        line-height: 1.4;
    }

    .toast-success {
        border-left: 4px solid #10b981;
    }
    .toast-success .toast-icon {
        color: #10b981;
    }

    .toast-error {
        border-left: 4px solid #ef4444;
    }
    .toast-error .toast-icon {
        color: #ef4444;
    }

    .toast-warning {
        border-left: 4px solid #f59e0b;
    }
    .toast-warning .toast-icon {
        color: #f59e0b;
    }

    .toast-info {
        border-left: 4px solid #3b82f6;
    }
    .toast-info .toast-icon {
        color: #3b82f6;
    }

    @@keyframes toast-slide-in {
        from {
            opacity: 0;
            transform: translateX(100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleToastChanged;
        ToastService.OnHide += HandleToastGuidChanged;
    }

    private void HandleToastChanged(ToastMessage toast)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleToastGuidChanged(Guid id)
    {
        InvokeAsync(StateHasChanged);
    }

    private static string GetIcon(ToastLevel level) => level switch
    {
        ToastLevel.Success => "check_circle",
        ToastLevel.Error => "error",
        ToastLevel.Warning => "warning",
        ToastLevel.Info => "info",
        _ => "notifications"
    };

    public void Dispose()
    {
        ToastService.OnShow -= HandleToastChanged;
        ToastService.OnHide -= HandleToastGuidChanged;
    }
}
