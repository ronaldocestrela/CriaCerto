@using CriaCerto.Web.Client.Models

@if (IsOpen)
{
    <div class="maternity-modal-backdrop" @onclick="Close">
        <div class="maternity-modal-card" @onclick:stopPropagation="true">
            <header class="maternity-modal-header">
                <div class="modal-title">
                    <span class="material-symbols-outlined header-icon">output</span>
                    <h3>Assistente de Desmame</h3>
                </div>
                <button type="button" class="close-btn" @onclick="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </header>

            <div class="maternity-modal-body">
                @if (SelectedFarrowing is not null)
                {
                    <div class="farrowing-info-chip">
                        <span class="material-symbols-outlined">info</span>
                        <span>Matriz: <strong>@SelectedFarrowing.SowId</strong> | Parto: @SelectedFarrowing.FarrowingDate.ToShortDateString() | Nascidos Vivos: @SelectedFarrowing.LiveBorn</span>
                    </div>
                }

                <div class="form-row">
                    <div class="form-group half">
                        <label class="form-label">Quantidade Desmamada *</label>
                        <div class="counter-controls compact">
                            <button type="button" class="touch-btn" @onclick="DecrementWeaned">-</button>
                            <span class="counter-value">@_weanedCount</span>
                            <button type="button" class="touch-btn" @onclick="IncrementWeaned">+</button>
                        </div>
                    </div>
                    <div class="form-group half">
                        <label class="form-label">Data do Desmame *</label>
                        <input type="datetime-local" class="form-input" @bind="_weaningDate" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Peso Total Desmamado (kg) *</label>
                    <input type="number" step="0.1" class="form-input" @bind="_totalWeanedWeightKg" placeholder="Ex: 77.0" />
                </div>

                <!-- Zootecnic Weaned Average Badge -->
                <div class="zootecnic-summary-badge @(IsWeightValid ? "valid" : "invalid")">
                    <div class="badge-row">
                        <span>Peso Médio por Leitão Desmamado:</span>
                        <strong>@($"{AverageWeanedWeight:F2} kg")</strong>
                    </div>
                    @if (AverageWeanedWeight > 0 && (AverageWeanedWeight < 4.0m || AverageWeanedWeight > 12.0m))
                    {
                        <p class="validation-warning">
                            <span class="material-symbols-outlined warning-icon">warning</span>
                            Atenção: Peso médio por desmamado fora da faixa ideal biológica (4.0kg - 12.0kg).
                        </p>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Baia / Lote de Destino (Creche) *</label>
                    <input type="text" class="form-input" @bind="_destinationPenOrBatch" placeholder="Ex: Creche Baia 01 - Lote 2026-A" />
                </div>

                <div class="form-group">
                    <label class="form-label">Observações</label>
                    <textarea class="form-textarea" @bind="_notes" placeholder="Condições de desmame, loteador responsável..."></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="modal-error-alert">
                        <span class="material-symbols-outlined">error</span>
                        <span>@ErrorMessage</span>
                    </div>
                }
            </div>

            <footer class="maternity-modal-footer">
                <button type="button" class="btn-secondary" @onclick="Close">Cancelar</button>
                <button type="button" class="btn-primary" disabled="@(!IsValid || IsSubmitting)" @onclick="Submit">
                    <span class="material-symbols-outlined">check_circle</span>
                    <span>Registrar Desmame</span>
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public FarrowingSummaryClientDto? SelectedFarrowing { get; set; }
    [Parameter] public EventCallback<RegisterWeaningRequest> OnSubmit { get; set; }

    private int _weanedCount = 10;
    private DateTime _weaningDate = DateTime.Now;
    private decimal _totalWeanedWeightKg = 70.0m;
    private string _destinationPenOrBatch = string.Empty;
    private string _notes = string.Empty;

    public string? ErrorMessage { get; set; }
    public bool IsSubmitting { get; set; }

    private decimal AverageWeanedWeight => _weanedCount > 0 ? _totalWeanedWeightKg / _weanedCount : 0m;
    private bool IsWeightValid => AverageWeanedWeight >= 4.0m && AverageWeanedWeight <= 12.0m;
    private bool IsValid => SelectedFarrowing is not null
                         && _weanedCount > 0
                         && _totalWeanedWeightKg > 0
                         && !string.IsNullOrWhiteSpace(_destinationPenOrBatch);

    protected override void OnParametersSet()
    {
        if (SelectedFarrowing is not null && SelectedFarrowing.LiveBorn > 0)
        {
            _weanedCount = SelectedFarrowing.LiveBorn;
            _totalWeanedWeightKg = Math.Round(SelectedFarrowing.LiveBorn * 7.0m, 1);
        }
    }

    private void IncrementWeaned() => _weanedCount++;
    private void DecrementWeaned() { if (_weanedCount > 1) _weanedCount--; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        if (SelectedFarrowing is null)
        {
            ErrorMessage = "Selecione um parto para registrar o desmame.";
            return;
        }

        if (!IsValid)
        {
            ErrorMessage = "Preencha todos os campos obrigatórios corretamente.";
            return;
        }

        ErrorMessage = null;
        IsSubmitting = true;

        var request = new RegisterWeaningRequest(
            SelectedFarrowing.Id,
            _weaningDate,
            _weanedCount,
            _totalWeanedWeightKg,
            _destinationPenOrBatch,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes);

        await OnSubmit.InvokeAsync(request);
        IsSubmitting = false;
        await Close();
    }
}
