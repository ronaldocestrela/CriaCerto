@using CriaCerto.Web.Client.Models
@inject CriaCerto.Web.Client.Services.GrowthApiClient GrowthApi

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pin-map me-2"></i>Novo Piquete / Pasto</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mb-3">@ErrorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nome do Pasto/Piquete</label>
                        <input type="text" class="form-control" @bind="Name" placeholder="Ex: Pasto da Baixada 01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Código / Identificador</label>
                        <input type="text" class="form-control text-uppercase" @bind="Code" placeholder="Ex: PIQ-01" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Área (Hectares)</label>
                            <input type="number" step="0.1" class="form-control" @bind="AreaHectares" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Capacidade Máx (UA)</label>
                            <input type="number" step="0.5" class="form-control" @bind="MaxCapacityUA" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status do Pasto</label>
                        <select class="form-select" @bind="Status">
                            <option value="@PaddockStatus.Active">Ativo (Em pastejo)</option>
                            <option value="@PaddockStatus.Resting">Pousio (Descanso)</option>
                            <option value="@PaddockStatus.Maintenance">Reforma / Manutenção</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                    <button type="button" class="btn btn-success fw-semibold" @onclick="SavePaddockAsync" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Salvar Piquete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string Name { get; set; } = string.Empty;
    private string Code { get; set; } = string.Empty;
    private decimal AreaHectares { get; set; } = 10.0m;
    private decimal MaxCapacityUA { get; set; } = 15.0m;
    private PaddockStatus Status { get; set; } = PaddockStatus.Active;
    private string? ErrorMessage { get; set; }
    private bool IsSubmitting { get; set; }

    private async Task SavePaddockAsync()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(Name) || string.IsNullOrWhiteSpace(Code))
        {
            ErrorMessage = "Preencha o nome e o código do piquete.";
            return;
        }

        if (AreaHectares <= 0 || MaxCapacityUA <= 0)
        {
            ErrorMessage = "A área e a capacidade devem ser maiores que zero.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var command = new CreatePaddockCommand(Name, Code, AreaHectares, MaxCapacityUA, TenantId, Status);
            var result = await GrowthApi.CreatePaddockAsync(command);
            if (result != null)
            {
                await OnSaved.InvokeAsync();
                await Close();
            }
            else
            {
                ErrorMessage = "Não foi possível cadastrar o piquete. Verifique se o código já existe.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        Name = string.Empty;
        Code = string.Empty;
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}
