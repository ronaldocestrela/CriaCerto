@using CriaCerto.Web.Client.Models
@inject CriaCerto.Web.Client.Services.GrowthApiClient GrowthApi

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-collection me-2"></i>Novo Lote de Animais</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mb-3">@ErrorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nome do Lote</label>
                        <input type="text" class="form-control" @bind="Name" placeholder="Ex: Lote Novilhas 2026" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Código / Identificador</label>
                            <input type="text" class="form-control text-uppercase" @bind="Code" placeholder="Ex: L-NOV-01" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Categoria Zootécnica</label>
                            <select class="form-select" @bind="Category">
                                <option value="@LotCategory.Bezerros">Bezerros(as)</option>
                                <option value="@LotCategory.Recria">Recria / Novilhas</option>
                                <option value="@LotCategory.Garrotes">Garrotes</option>
                                <option value="@LotCategory.Engorda">Engorda / Boi Gordo</option>
                                <option value="@LotCategory.Matrizes">Matrizes / Vacas</option>
                                <option value="@LotCategory.Reprodutores">Reprodutores / Touros</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Qtd de Cabeças</label>
                            <input type="number" class="form-control" @bind="HeadCount" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Peso Médio (kg)</label>
                            <input type="number" step="0.5" class="form-control" @bind="AverageWeightKg" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded mb-3 border">
                        <div class="d-flex justify-content-between text-muted small">
                            <span>Peso Total Estimado:</span>
                            <strong class="text-dark">@TotalWeightKg.ToString("N0") kg</strong>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span>Carga Estimada em UA:</span>
                            <strong class="text-primary fw-bold">@TotalUA.ToString("F2") UA</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Piquete de Destino Inicial (Opcional)</label>
                        <select class="form-select" @bind="InitialPaddockId">
                            <option value="">-- Selecionar mais tarde --</option>
                            @foreach (var paddock in Paddocks)
                            {
                                <option value="@paddock.Id">@paddock.Code - @paddock.Name (Lotação: @paddock.CurrentTotalUA/@paddock.MaxCapacityUA UA)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-semibold" @onclick="SaveLotAsync" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Criar Lote
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public List<PaddockStockingRateDto> Paddocks { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string Name { get; set; } = string.Empty;
    private string Code { get; set; } = string.Empty;
    private LotCategory Category { get; set; } = LotCategory.Recria;
    private int HeadCount { get; set; } = 20;
    private decimal AverageWeightKg { get; set; } = 300.0m;
    private Guid? InitialPaddockId { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsSubmitting { get; set; }

    private decimal TotalWeightKg => HeadCount * AverageWeightKg;
    private decimal TotalUA => Math.Round(TotalWeightKg / 450.0m, 2);

    private async Task SaveLotAsync()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(Name) || string.IsNullOrWhiteSpace(Code))
        {
            ErrorMessage = "Preencha o nome e o código do lote.";
            return;
        }

        if (HeadCount <= 0 || AverageWeightKg <= 0)
        {
            ErrorMessage = "Quantidade de cabeças e peso médio devem ser maiores que zero.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var command = new CreateLotCommand(Name, Code, Category, HeadCount, AverageWeightKg, TenantId, InitialPaddockId);
            var result = await GrowthApi.CreateLotAsync(command);
            if (result != null)
            {
                await OnSaved.InvokeAsync();
                await Close();
            }
            else
            {
                ErrorMessage = "Não foi possível criar o lote. Verifique se o código já existe.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        Name = string.Empty;
        Code = string.Empty;
        InitialPaddockId = null;
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}
