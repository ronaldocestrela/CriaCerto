@using CriaCerto.Web.Client.Models

<div class="card h-100 shadow-sm border-0 position-relative paddock-card @GetCardBorderClass()">
    <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-secondary text-white me-2">@Paddock.Code</span>
            <h6 class="card-title fw-bold mb-0 d-inline text-dark">@Paddock.Name</h6>
        </div>
        <div>
            <span class="badge @GetStatusBadgeClass()">
                @GetStatusText()
            </span>
        </div>
    </div>
    <div class="card-body py-2">
        <div class="row text-center mb-3 g-2">
            <div class="col-6">
                <div class="p-2 bg-light rounded">
                    <div class="text-muted small">Taxa de Lotação</div>
                    <div class="fs-5 fw-bold @GetStockingRateTextClass()">
                        @Paddock.CurrentStockingRateUAPerHa.ToString("F2") <small class="fs-6 text-muted">UA/ha</small>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-2 bg-light rounded">
                    <div class="text-muted small">Carga Atual / Máx</div>
                    <div class="fs-6 fw-semibold text-dark">
                        @Paddock.CurrentTotalUA / @Paddock.MaxCapacityUA <small class="text-muted">UA</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Ocupação (@Paddock.AreaHectares ha)</span>
                <span>@GetCapacityPercentage()%</span>
            </div>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar @GetProgressBarClass()" role="progressbar" style="width: @GetCapacityPercentage()%" aria-valuenow="@GetCapacityPercentage()" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <div class="d-flex justify-content-between text-muted small border-top pt-2">
            <span><i class="bi bi-hash"></i> @Paddock.TotalHeadCount cabeças</span>
            <span><i class="bi bi-layers"></i> @Paddock.AssignedLotsCount lotes</span>
        </div>
    </div>
    <div class="card-footer bg-white border-top-0 pb-3 pt-1">
        <button class="btn btn-outline-primary btn-sm w-100 fw-semibold" @onclick="() => OnMoveClick.InvokeAsync(Paddock.Id)">
            <i class="bi bi-arrows-move me-1"></i> Manejar Lote
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PaddockStockingRateDto Paddock { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnMoveClick { get; set; }

    private decimal GetCapacityPercentage()
    {
        if (Paddock.MaxCapacityUA <= 0) return 0;
        var percentage = (Paddock.CurrentTotalUA / Paddock.MaxCapacityUA) * 100m;
        return Math.Min(Math.Round(percentage, 1), 100m);
    }

    private string GetStatusText() => Paddock.Status switch
    {
        PaddockStatus.Resting => "Pousio",
        PaddockStatus.Maintenance => "Reforma",
        _ when Paddock.IsOvergrazed => "SOBREPASTEJO",
        _ when Paddock.IsNearCapacity => "CAPACIDADE LIME",
        _ => "Ativo"
    };

    private string GetStatusBadgeClass() => Paddock.Status switch
    {
        PaddockStatus.Resting => "bg-secondary",
        PaddockStatus.Maintenance => "bg-warning text-dark",
        _ when Paddock.IsOvergrazed => "bg-danger text-white animate-pulse",
        _ when Paddock.IsNearCapacity => "bg-warning text-dark",
        _ => "bg-success"
    };

    private string GetCardBorderClass() => Paddock.IsOvergrazed
        ? "border-danger border-2 shadow"
        : Paddock.IsNearCapacity
            ? "border-warning border-2"
            : "";

    private string GetStockingRateTextClass() => Paddock.IsOvergrazed
        ? "text-danger"
        : Paddock.IsNearCapacity
            ? "text-warning"
            : "text-success";

    private string GetProgressBarClass() => Paddock.IsOvergrazed
        ? "bg-danger"
        : Paddock.IsNearCapacity
            ? "bg-warning"
            : "bg-success";
}
