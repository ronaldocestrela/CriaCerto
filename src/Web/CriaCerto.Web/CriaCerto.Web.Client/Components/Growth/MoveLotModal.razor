@using CriaCerto.Web.Client.Models
@inject CriaCerto.Web.Client.Services.GrowthApiClient GrowthApi
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-arrows-move me-2 text-warning"></i>Manejar / Mover Lote de Pasto</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mb-3">@ErrorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lote a ser Movimentado</label>
                        <select class="form-select" @bind="SelectedLotId" @bind:after="OnLotChanged">
                            <option value="">-- Selecione o Lote --</option>
                            @foreach (var lot in ActiveLots)
                            {
                                <option value="@lot.Id">
                                    @lot.Code - @lot.Name (@lot.HeadCount cab, @lot.TotalUA UA)
                                    @(lot.PaddockName != null ? $" [Pasto Atual: {lot.PaddockName}]" : " [Sem Pasto Alocado]")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Piquete de Destino</label>
                        <select class="form-select" @bind="SelectedPaddockId" @bind:after="OnPaddockChanged">
                            <option value="">-- Desalocar / Retirar do Pasto --</option>
                            @foreach (var paddock in Paddocks)
                            {
                                <option value="@paddock.Id">
                                    @paddock.Code - @paddock.Name (Capacidade: @paddock.CurrentTotalUA/@paddock.MaxCapacityUA UA | @paddock.AreaHectares ha)
                                </option>
                            }
                        </select>
                    </div>

                    @if (SelectedPaddock != null && SelectedLot != null)
                    {
                        <div class="p-3 rounded mb-3 @GetImpactContainerClass()">
                            <div class="fw-bold mb-1 d-flex align-items-center">
                                <i class="bi @GetImpactIconClass() me-2"></i> Preview de Lotação do Destino
                            </div>
                            <div class="small">
                                Carga Atual: <strong>@SelectedPaddock.CurrentTotalUA UA</strong> → Carga Nova: <strong>@NewTotalUA UA</strong> (Máx: @SelectedPaddock.MaxCapacityUA UA)
                            </div>
                            <div class="small">
                                Nova Taxa de Lotação: <strong>@NewStockingRate.ToString("F2") UA/ha</strong>
                            </div>

                            @if (IsOvergrazed)
                            {
                                <div class="mt-2 text-danger fw-bold small">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> ATENÇÃO: Esta movimentação resultará em SOBREPASTEJO / SUPERLOTAÇÃO no piquete de destino!
                                </div>
                            }
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Observações / Motivo da Troca</label>
                        <textarea class="form-control" rows="2" @bind="Notes" placeholder="Ex: Rodízio de piquetes, descanso de pastagem ou desmame."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                    <button type="button" class="btn btn-warning fw-semibold text-dark" @onclick="ExecuteMoveAsync" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Confirmar Movimentação
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public Guid? PreSelectedPaddockId { get; set; }
    [Parameter] public List<LotDto> ActiveLots { get; set; } = new();
    [Parameter] public List<PaddockStockingRateDto> Paddocks { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Guid? SelectedLotId { get; set; }
    private Guid? SelectedPaddockId { get; set; }
    private string Notes { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsSubmitting { get; set; }

    private LotDto? SelectedLot => ActiveLots.FirstOrDefault(l => l.Id == SelectedLotId);
    private PaddockStockingRateDto? SelectedPaddock => Paddocks.FirstOrDefault(p => p.Id == SelectedPaddockId);

    private decimal NewTotalUA => (SelectedPaddock?.CurrentTotalUA ?? 0m) + (SelectedLot?.TotalUA ?? 0m);
    private decimal NewStockingRate => SelectedPaddock != null && SelectedPaddock.AreaHectares > 0
        ? Math.Round(NewTotalUA / SelectedPaddock.AreaHectares, 2)
        : 0m;

    private bool IsOvergrazed => SelectedPaddock != null && NewTotalUA > SelectedPaddock.MaxCapacityUA;

    protected override void OnParametersSet()
    {
        if (IsOpen && PreSelectedPaddockId.HasValue)
        {
            SelectedPaddockId = PreSelectedPaddockId.Value;
        }
    }

    private void OnLotChanged() { }
    private void OnPaddockChanged() { }

    private string GetImpactContainerClass() => IsOvergrazed
        ? "bg-danger-subtle text-danger border border-danger"
        : "bg-light text-dark border";

    private string GetImpactIconClass() => IsOvergrazed
        ? "bi-exclamation-triangle-fill text-danger"
        : "bi-info-circle-fill text-primary";

    private async Task ExecuteMoveAsync()
    {
        ErrorMessage = null;
        if (!SelectedLotId.HasValue)
        {
            ErrorMessage = "Selecione um lote para movimentar.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var command = new MoveLotToPaddockCommand(SelectedLotId.Value, SelectedPaddockId, Notes, TenantId);
            var result = await GrowthApi.MoveLotAsync(command);

            if (result != null)
            {
                await OnSaved.InvokeAsync();
                await Close();
            }
            else
            {
                // Fallback offline: Save to IndexedDB if offline or server unreachable
                var offlineQueued = await QueueOfflineMovementAsync(command);
                if (offlineQueued)
                {
                    await OnSaved.InvokeAsync();
                    await Close();
                }
                else
                {
                    ErrorMessage = "Falha ao registrar movimentação do lote.";
                }
            }
        }
        catch
        {
            // Offline queueing fallback
            var offlineQueued = await QueueOfflineMovementAsync(new MoveLotToPaddockCommand(SelectedLotId.Value, SelectedPaddockId, Notes, TenantId));
            if (offlineQueued)
            {
                await OnSaved.InvokeAsync();
                await Close();
            }
            else
            {
                ErrorMessage = "Erro de conexão e falha ao gravar na fila offline.";
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task<bool> QueueOfflineMovementAsync(MoveLotToPaddockCommand command)
    {
        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(command);
            await JS.InvokeVoidAsync("localStorage.setItem", $"offline_movement_{Guid.NewGuid()}", payload);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private async Task Close()
    {
        SelectedLotId = null;
        SelectedPaddockId = null;
        Notes = string.Empty;
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}
