@namespace CriaCerto.Web.Client.Components.Growth

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-success">
            <i class="bi bi-graph-up-arrow me-2"></i>Evolução de Peso e Ganho Diário (GPD)
        </h6>
        @if (History != null && History.Any())
        {
            <span class="badge bg-light text-dark border">
                @History.Count pesagens registradas
            </span>
        }
    </div>
    <div class="card-body">
        @if (History == null || !History.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-bar-chart-line fs-2 d-block mb-2"></i>
                Nenhum histórico de pesagem para exibir gráfico.
            </div>
        }
        else
        {
            var orderedHistory = History.OrderBy(h => h.WeighingDate).ToList();
            decimal minWeight = Math.Max(0, orderedHistory.Min(h => h.WeightKg) - 20);
            decimal maxWeight = orderedHistory.Max(h => h.WeightKg) + 20;
            decimal weightRange = maxWeight - minWeight == 0 ? 1 : maxWeight - minWeight;

            int width = 600;
            int height = 240;
            int padding = 40;
            int chartWidth = width - (padding * 2);
            int chartHeight = height - (padding * 2);

            <svg viewBox="0 0 @width @height" class="w-100" style="max-height: 280px;">
                <!-- Grid Lines -->
                @for (int i = 0; i <= 4; i++)
                {
                    int y = padding + (chartHeight * i / 4);
                    decimal weightVal = maxWeight - (weightRange * i / 4);
                    <line x1="@padding" y1="@y" x2="@(width - padding)" y2="@y" stroke="#e9ecef" stroke-dasharray="4" />
                    <text x="@(padding - 8)" y="@(y + 4)" font-size="10" fill="#6c757d" text-anchor="end">@Math.Round(weightVal) kg</text>
                }

                <!-- Data Points and Line -->
                @{
                    string pointsStr = "";
                    for (int i = 0; i < orderedHistory.Count; i++)
                    {
                        var item = orderedHistory[i];
                        int x = orderedHistory.Count == 1 
                            ? width / 2 
                            : padding + (chartWidth * i / (orderedHistory.Count - 1));
                        
                        int y = padding + (int)(chartHeight * (1 - ((item.WeightKg - minWeight) / weightRange)));
                        pointsStr += $"{x},{y} ";
                    }
                }

                <!-- SVG Path -->
                <polyline fill="none" stroke="#198754" stroke-width="3" points="@pointsStr.Trim()" />

                <!-- Markers -->
                @for (int i = 0; i < orderedHistory.Count; i++)
                {
                    var item = orderedHistory[i];
                    int x = orderedHistory.Count == 1 
                        ? width / 2 
                        : padding + (chartWidth * i / (orderedHistory.Count - 1));
                    int y = padding + (int)(chartHeight * (1 - ((item.WeightKg - minWeight) / weightRange)));

                    string circleColor = item.IsWeightLossWarning ? "#dc3545" : "#198754";

                    <circle cx="@x" cy="@y" r="5" fill="@circleColor" stroke="#fff" stroke-width="2" />
                    <text x="@x" y="@(y - 10)" font-size="11" font-weight="bold" fill="@circleColor" text-anchor="middle">
                        @item.WeightKg.ToString("N0") kg (@item.CalculatedArrobasTotal.ToString("N1")@)
                    </text>
                    <text x="@x" y="@(height - 12)" font-size="10" fill="#6c757d" text-anchor="middle">
                        @item.WeighingDate.ToString("dd/MM")
                    </text>
                }
            </svg>

            <!-- Legend & Stats -->
            <div class="d-flex justify-content-around mt-3 pt-2 border-top text-center fs-7">
                <div>
                    <span class="text-muted d-block">Último Peso Vivo</span>
                    <strong class="text-dark fs-6">@orderedHistory.Last().WeightKg.ToString("N1") kg</strong>
                </div>
                <div>
                    <span class="text-muted d-block">Arrobas Estimadas</span>
                    <strong class="text-success fs-6">@orderedHistory.Last().CalculatedArrobasTotal.ToString("N1") @</strong>
                </div>
                <div>
                    <span class="text-muted d-block">GPD Médio</span>
                    <strong class="@(orderedHistory.Last().IsWeightLossWarning ? "text-danger" : "text-primary") fs-6">
                        @orderedHistory.Last().CalculatedAdgKgPerDay.ToString("N2") kg/dia
                    </strong>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<WeighingPointModel>? History { get; set; }

    public class WeighingPointModel
    {
        public DateTime WeighingDate { get; set; }
        public decimal WeightKg { get; set; }
        public decimal CalculatedArrobasTotal { get; set; }
        public decimal CalculatedAdgKgPerDay { get; set; }
        public bool IsWeightLossWarning { get; set; }
    }
}
