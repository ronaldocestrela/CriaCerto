@using CriaCerto.Web.Client.Models
@using CriaCerto.Web.Client.Services
@inject IOfflineSyncService SyncService

@if (IsOpen && CurrentConflict != null)
{
    <div class="sync-modal-backdrop" @onclick="Close">
        <div class="sync-modal-content" @onclick:stopPropagation="true" role="dialog" aria-labelledby="modal-title" aria-modal="true">
            <div class="sync-modal-header">
                <div class="header-title-container">
                    <span class="material-symbols-outlined warning-icon">warning</span>
                    <h3 id="modal-title">Mediação de Conflito de Dados</h3>
                </div>
                <button type="button" class="btn-close-icon" @onclick="Close" aria-label="Fechar">&times;</button>
            </div>

            <div class="sync-modal-body">
                <p class="conflict-description">
                    Foram encontradas divergências entre o registro efetuado no campo e os dados presentes no servidor central para <strong>@CurrentConflict.EntityName</strong> (Ação: @CurrentConflict.EntityIdentifier).
                </p>

                <div class="conflict-comparison-grid">
                    <div class="comparison-card local-card">
                        <div class="card-header">
                            <span class="material-symbols-outlined">phone_android</span>
                            <h4>Dados Registrados no Campo (Local)</h4>
                        </div>
                        <div class="card-body">
                            <pre class="json-preview">@FormatJson(CurrentConflict.LocalPayloadJson)</pre>
                        </div>
                    </div>

                    <div class="comparison-card server-card">
                        <div class="card-header">
                            <span class="material-symbols-outlined">cloud</span>
                            <h4>Dados Atuais no Servidor (Nuvem)</h4>
                        </div>
                        <div class="card-body">
                            <pre class="json-preview">@FormatJson(CurrentConflict.ServerPayloadJson)</pre>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="sync-error-banner" role="alert">
                        <span class="material-symbols-outlined">error</span>
                        <span>@ErrorMessage</span>
                    </div>
                }
            </div>

            <div class="sync-modal-footer">
                <button type="button" class="btn btn-outline" @onclick="Close" disabled="@IsProcessing">
                    Resolver Mais Tarde
                </button>
                <button type="button" class="btn btn-secondary" @onclick="() => Resolve(ConflictResolutionOption.UseServer)" disabled="@IsProcessing">
                    <span class="material-symbols-outlined">cloud_download</span>
                    Manter Versão do Servidor
                </button>
                <button type="button" class="btn btn-primary" @onclick="() => Resolve(ConflictResolutionOption.UseLocal)" disabled="@IsProcessing">
                    <span class="material-symbols-outlined">cloud_upload</span>
                    Manter Versão do Campo (Sobrescrever)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public SyncConflictItem? CurrentConflict { get; set; }

    private bool IsProcessing { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task Resolve(ConflictResolutionOption option)
    {
        if (CurrentConflict == null) return;

        IsProcessing = true;
        ErrorMessage = null;

        var result = await SyncService.ResolveConflictAsync(CurrentConflict.OperationId, option);

        IsProcessing = false;

        if (result.IsSuccess)
        {
            await Close();
        }
        else
        {
            ErrorMessage = result.Error.Message;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private string FormatJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "{ }";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}
