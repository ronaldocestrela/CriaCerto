@using CriaCerto.Web.Client.Services

@if (IsOpen)
{
    <div style="position: fixed; inset: 0; background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background-color: white; border-radius: 12px; border: 1px solid var(--cc-border); width: 100%; max-width: 550px; padding: 1.5rem; box-shadow: var(--cc-shadow); display: flex; flex-direction: column; gap: 1.25rem;" class="font-headline">
            
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--cc-border); padding-bottom: 1rem;">
                <div>
                    <h3 style="margin: 0; font-size: 20px; font-weight: bold; color: var(--cc-ink);">Convidar Novo Membro da Equipe</h3>
                    <p style="margin: 0.25rem 0 0 0; font-size: 13px; color: var(--cc-ink-muted);">Envie um convite por e-mail com controle de permissão RBAC.</p>
                </div>
                <button @onclick="Close" style="background: transparent; border: none; color: var(--cc-ink-muted); cursor: pointer;">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Form -->
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                
                <div>
                    <label style="font-size: 12px; font-weight: bold; color: var(--cc-ink); text-transform: uppercase;" class="font-mono">E-mail do Colaborador *</label>
                    <input type="email" @bind="_email" style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--cc-border); border-radius: 6px; font-size: 14px; margin-top: 0.25rem;" placeholder="ex: zootecnista@fazenda.com.br" />
                </div>

                <div>
                    <label style="font-size: 12px; font-weight: bold; color: var(--cc-ink); text-transform: uppercase;" class="font-mono">Perfil de Acesso / Função (RBAC) *</label>
                    <select @bind="_roleInt" style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--cc-border); border-radius: 6px; font-size: 14px; margin-top: 0.25rem; background: white;">
                        <option value="1">Admin - Acesso total à granja, finanças e membros</option>
                        <option value="2">Zootecnista - Gestão zootécnica, nutrição, GPD e plantel</option>
                        <option value="3">Veterinário - Protocolos sanitários, vacinas e carência</option>
                        <option value="4">Operador de Curral - Pesagem, loteamento e trato de campo (Off-line)</option>
                    </select>
                </div>

                <!-- Info callout -->
                <div style="background-color: var(--cc-canvas); border: 1px solid var(--cc-border); border-radius: 8px; padding: 0.75rem 1rem; display: flex; align-items: flex-start; gap: 0.75rem;">
                    <span class="material-symbols-outlined" style="color: var(--cc-primary); font-size: 20px; margin-top: 2px;">info</span>
                    <div style="font-size: 12.5px; color: var(--cc-ink-muted); line-height: 1.4;">
                        O usuário receberá um e-mail com link e token válido por <strong>7 dias</strong> para associar sua conta à fazenda.
                    </div>
                </div>

            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="background-color: #fef2f2; color: #991b1b; padding: 0.75rem; border-radius: 6px; font-size: 13px; border: 1px solid #fecaca;">
                    @_errorMessage
                </div>
            }

            <!-- Actions -->
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--cc-border); padding-top: 1rem;">
                <button @onclick="Close" style="background: white; border: 1px solid var(--cc-border); padding: 0.5rem 1.25rem; border-radius: 6px; font-weight: bold; cursor: pointer; color: var(--cc-ink-muted);">
                    Cancelar
                </button>
                <button @onclick="SaveAsync" disabled="@_isSaving" style="background: var(--cc-primary); color: white; border: none; padding: 0.5rem 1.5rem; border-radius: 6px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                    @if (_isSaving)
                    {
                        <span>Enviando Convite...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 16px;">send</span>
                        <span>Enviar Convite</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public EventCallback<TeamInviteModel> OnInvited { get; set; }
    [Inject] public TenancyApiClient TenancyApi { get; set; } = default!;

    private string _email = string.Empty;
    private int _roleInt = 2; // Default Zootecnista
    private bool _isSaving;
    private string? _errorMessage;

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains("@"))
        {
            _errorMessage = "Informe um e-mail válido para envio do convite.";
            return;
        }

        _isSaving = true;

        var req = new InviteTeamMemberRequest(TenantId, _email, _roleInt);
        var invited = await TenancyApi.InviteTeamMemberAsync(req);

        _isSaving = false;

        if (invited is not null)
        {
            await OnInvited.InvokeAsync(invited);
            _email = string.Empty;
            await Close();
        }
        else
        {
            _errorMessage = "Não foi possível enviar o convite.";
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
