@using CriaCerto.Web.Client.Services

@if (IsOpen)
{
    <div style="position: fixed; inset: 0; background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background-color: white; border-radius: 12px; border: 1px solid var(--cc-border); width: 100%; max-width: 550px; padding: 1.5rem; box-shadow: var(--cc-shadow); display: flex; flex-direction: column; gap: 1.25rem;" class="font-headline">
            
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--cc-border); padding-bottom: 1rem;">
                <div>
                    <h3 style="margin: 0; font-size: 20px; font-weight: bold; color: var(--cc-ink);">Cadastrar Nova Unidade de Produção</h3>
                    <p style="margin: 0.25rem 0 0 0; font-size: 13px; color: var(--cc-ink-muted);">Adicione retiros, crechários ou módulos de confinamento à fazenda.</p>
                </div>
                <button @onclick="Close" style="background: transparent; border: none; color: var(--cc-ink-muted); cursor: pointer;">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Form -->
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                
                <div style="grid-column: span 2;">
                    <label style="font-size: 12px; font-weight: bold; color: var(--cc-ink); text-transform: uppercase;" class="font-mono">Nome da Unidade *</label>
                    <input type="text" @bind="_name" style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--cc-border); border-radius: 6px; font-size: 14px; margin-top: 0.25rem;" placeholder="Ex: Unidade Matriz 02 / Retiro Norte" />
                </div>

                <div>
                    <label style="font-size: 12px; font-weight: bold; color: var(--cc-ink); text-transform: uppercase;" class="font-mono">Tipo de Unidade *</label>
                    <select @bind="_type" style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--cc-border); border-radius: 6px; font-size: 14px; margin-top: 0.25rem; background: white;">
                        <option value="Gestação">Gestação</option>
                        <option value="Creche">Creche</option>
                        <option value="Recria">Recria</option>
                        <option value="Engorda">Engorda / Terminação</option>
                        <option value="Retiro">Retiro</option>
                        <option value="Matriz">Matriz</option>
                        <option value="Confinamento">Confinamento</option>
                    </select>
                </div>

                <div>
                    <label style="font-size: 12px; font-weight: bold; color: var(--cc-ink); text-transform: uppercase;" class="font-mono">Capacidade (Cabeças) *</label>
                    <input type="number" @bind="_capacity" style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--cc-border); border-radius: 6px; font-size: 14px; margin-top: 0.25rem;" placeholder="2500" />
                </div>

                <div style="grid-column: span 2;">
                    <label style="font-size: 12px; font-weight: bold; color: var(--cc-ink); text-transform: uppercase;" class="font-mono">Localização / Observações</label>
                    <input type="text" @bind="_locationDetails" style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--cc-border); border-radius: 6px; font-size: 14px; margin-top: 0.25rem;" placeholder="Ex: Setor Leste, Piquete 12 ao 18" />
                </div>

            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="background-color: #fef2f2; color: #991b1b; padding: 0.75rem; border-radius: 6px; font-size: 13px; border: 1px solid #fecaca;">
                    @_errorMessage
                </div>
            }

            <!-- Actions -->
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--cc-border); padding-top: 1rem;">
                <button @onclick="Close" style="background: white; border: 1px solid var(--cc-border); padding: 0.5rem 1.25rem; border-radius: 6px; font-weight: bold; cursor: pointer; color: var(--cc-ink-muted);">
                    Cancelar
                </button>
                <button @onclick="SaveAsync" disabled="@_isSaving" style="background: var(--cc-primary); color: white; border: none; padding: 0.5rem 1.5rem; border-radius: 6px; font-weight: bold; cursor: pointer;">
                    @if (_isSaving)
                    {
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <span>Cadastrar Unidade</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public EventCallback<ProductionUnitModel> OnCreated { get; set; }
    [Inject] public TenancyApiClient TenancyApi { get; set; } = default!;

    private string _name = string.Empty;
    private string _type = "Retiro";
    private int _capacity = 1000;
    private string? _locationDetails;
    private bool _isSaving;
    private string? _errorMessage;

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = "O nome da unidade de produção é obrigatório.";
            return;
        }

        if (_capacity <= 0)
        {
            _errorMessage = "A capacidade deve ser maior que zero.";
            return;
        }

        _isSaving = true;

        var req = new CreateProductionUnitRequest(
            TenantId,
            _name,
            _type,
            _capacity,
            _locationDetails
        );

        var created = await TenancyApi.CreateProductionUnitAsync(req);

        _isSaving = false;

        if (created is not null)
        {
            await OnCreated.InvokeAsync(created);
            await Close();
        }
        else
        {
            _errorMessage = "Não foi possível cadastrar a unidade de produção.";
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
